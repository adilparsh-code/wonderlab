{
  "name": "wonderlab-learning-arcade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run src/components/security.test.tsx src/components/privacy.test.tsx",
    "test:quality": "node --test scripts/quality-gates.test.mjs",
    "test:browser": "node scripts/security-browser.mjs",
    "test:universe": "node scripts/universe-browser.mjs",
    "validate:export": "node scripts/security-artifacts.mjs",
    "audit:dependencies": "npm audit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:quality && npm run build && npm run validate:export"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
